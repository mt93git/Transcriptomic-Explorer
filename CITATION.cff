title: "NeuMapp Spatial Suite & Transcriptomic Explorer"
version: "2.1.0"
date-released: 2026-01-15
url: "https://github.com/mt93git/Transcriptomic-Explorer"
repository-code: "https://github.com/mt93git/Transcriptomic-Explorer"
license: "MIT"
abstract: "Integrated computational platform coupling an interactive R/Shiny frontend for single-cell and spatial transcriptomics with a Python scientific engine for constrained spatial niche deconvolution, Moran's I autocorrelation, spectral diffusion maps, and Markovian fate dynamics."
keywords:
  - "spatial-transcriptomics"
  - "deconvolution"
  - "single-cell"
  - "scrna-seq"
  - "diffusion-maps"
  - "trajectory-inference"
  - "markov-chains"
  - "seurat"
  - "r-shiny"
  - "python"
