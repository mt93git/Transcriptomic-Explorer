cff-version: 1.2.0
message: "If you use this software in academic research, please cite it as below."
authors:
  - family-names: "Tricaud"
    given-names: "Maxence"
    email: "mtricaud.cetri@gmail.com"
title: "NeuMapp Explorer: Multi-Omic Landscape of Neutrophil Architecture, Trajectory Dynamics, and Spatial Tissue Compartmentalization"
version: "2.1.0"
date-released: 2026-01-15
url: "https://github.com/mt93git/Transcriptomic-Explorer"
repository-code: "https://github.com/mt93git/Transcriptomic-Explorer"
license: "MIT"
abstract: "Interactive multi-omic platform coupling an R/Shiny visualization frontend with a Python scientific computing engine for exploring neutrophil transcriptomic architecture, single-cell trajectory inference (diffusion maps, DPT), and spatial tissue hub compartmentalization (constrained NNLS deconvolution and Moran's I autocorrelation)."
keywords:
  - "neutrophils"
  - "spatial-transcriptomics"
  - "tissue-compartmentalization"
  - "deconvolution"
  - "single-cell"
  - "scrna-seq"
  - "diffusion-maps"
  - "trajectory-inference"
  - "chronomics"
  - "seurat-v5"
  - "r-shiny"
  - "python"
